<?xml version="1.0"?>
<robot name="six_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find mybot_description)/urdf/large_base.xacro" />

    <!-- Transmission is important to link the joints and the controller -->
    <xacro:macro name="wheel_transmission" params="prefix">
        <transmission name="${prefix}_wheel_joint_trans">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="${prefix}_wheel_joint">
                <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
            </joint>
            <actuator name="${prefix}_wheel_joint_motor">
                <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
                <mechanicalReduction>1</mechanicalReduction>
            </actuator>
        </transmission>

        <gazebo reference="${prefix}_wheel_link">
            <material>Gazebo/Gray</material>
            <mu1>100000.0</mu1>
            <mu2>100000.0</mu2>
        </gazebo>
    </xacro:macro>

    <!-- /////////////////////////////////   Gazebo   ////////////////////////////////////// -->
    <gazebo reference="base_footprint">
        <turnGravityOff>false</turnGravityOff>
    </gazebo>
    <gazebo reference="base_link">
        <material>Gazebo/Blue</material>
        <contact>
            <ode>
              <!-- 软接触: 臂杆/底盘剐蹭墙体时不产生爆炸性冲量(位置控制的
                   关节在接触中反打会把底盘掀飞); 驱动轮保持默认刚性 -->
              <kp>10000</kp>
              <kd>10</kd>
              <max_vel>0.05</max_vel>
              <min_depth>0.01</min_depth>
            </ode>
          </contact>
    </gazebo>

    <gazebo reference="back_caster_link">
        <material>Gazebo/Black</material>
        <contact>
            <ode>
              <!-- 软接触: 臂杆/底盘剐蹭墙体时不产生爆炸性冲量(位置控制的
                   关节在接触中反打会把底盘掀飞); 驱动轮保持默认刚性 -->
              <kp>10000</kp>
              <kd>10</kd>
              <max_vel>0.05</max_vel>
              <min_depth>0.01</min_depth>
            </ode>
          </contact>
    </gazebo>

    <xacro:wheel_transmission prefix="left" />
    <xacro:wheel_transmission prefix="right" />


    <!-- controller -->
    <gazebo>
        <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
            <!-- Keep odom TF fresher than the 20 Hz lidar under GUI load. -->
            <update_rate>100</update_rate>
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
	    <wheel_separation>${base_width + wheel_length}</wheel_separation>
            <wheel_diameter>${2*wheel_radius}</wheel_diameter>
            <max_wheel_torque>10</max_wheel_torque>
            <max_wheel_acceleration>1.0</max_wheel_acceleration>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_wheel_tf>true</publish_wheel_tf>
            <odometry_topic>odom</odometry_topic>
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
            <odometry_source>1</odometry_source>
        </plugin>
    </gazebo>
</robot>
