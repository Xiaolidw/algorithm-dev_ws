<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nav_simple</name>
  <version>0.0.0</version>
  <description>简化版Nav2导航模块（无大模型依赖）</description>
  <maintainer email="your_email@example.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <!-- 编译工具依赖（固定） -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- 运行时依赖（核心！必须包含导航节点用到的所有ROS2包） -->
  <exec_depend>rclpy</exec_depend>                  <!-- ROS2 Python核心库 -->
  <exec_depend>nav2_msgs</exec_depend>              <!-- Nav2动作消息类型 -->
  <exec_depend>geometry_msgs</exec_depend>          <!-- 位姿消息类型（PoseStamped等） -->
  <exec_depend>std_msgs</exec_depend>               <!-- 标准消息类型（String等） -->

  <!-- 测试依赖（可选） -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- 导出配置（固定） -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
