[Unit]
Description=Moon Warehouse competition simulation and ROS 2 stack
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/ros/dev_ws
ExecStartPre=/home/ros/dev_ws/scripts/cleanup_fastdds_shm.sh
ExecStart=/home/ros/dev_ws/scripts/run_competition.sh
ExecStartPost=/home/ros/dev_ws/scripts/wait_nav_ready.sh
KillMode=control-group
KillSignal=SIGINT
SuccessExitStatus=130 143 SIGINT SIGTERM
TimeoutStartSec=360
TimeoutStopSec=25
SendSIGKILL=yes
# Gazebo may terminate with exit code 0 when its rendering context closes.
# The launch file then shuts down the whole stack intentionally; always bring
# one coherent simulation back.  An explicit systemctl stop is not restarted.
Restart=always
RestartSec=8

[Install]
WantedBy=graphical-session.target
